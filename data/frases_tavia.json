   "tipo": "textual",
   "confianza": "Alta",
   "tono": "suave"
  },
  {
   "id": "f059",
   "contexto": "tropiezo",
   "texto": "Haz lo mejor que puedas hasta saber más. Cuando sepas más, hazlo mejor.",
