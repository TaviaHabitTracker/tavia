 "frases": [
  {
   "id": "f001",
   "contexto": "inicio",
   "texto": "Un viaje de mil millas comienza con un solo paso.",
   "autor": "Lao Tse",
   "rol": "filosofo",
   "fuente": "Tao Te Ching, cap. 64",
   "tipo": "textual",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f002",
   "contexto": "inicio",
   "texto": "El comienzo es la parte más importante de toda obra.",
   "autor": "Platón",
   "rol": "filosofo",
   "fuente": "La República, II (377a)",
   "tipo": "textual",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f003",
   "contexto": "inicio",
   "texto": "Puedes fallar en lo que no quieres, así que más vale arriesgarte con lo que amas.",
   "autor": "Jim Carrey",
   "rol": "artista",
   "fuente": "Discurso de graduación, Universidad Maharishi, 2014",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "suave"
  },
  {
   "id": "f004",
   "contexto": "inicio",
   "texto": "Ten paciencia con todo lo que no está resuelto en tu corazón… vive ahora las preguntas.",
   "autor": "Rainer Maria Rilke",
   "rol": "escritor",
   "fuente": "Cartas a un joven poeta, 1903",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "suave"
  },
  {
   "id": "f005",
   "contexto": "inicio",
   "texto": "Siempre es el día uno.",
   "autor": "Jeff Bezos",
   "rol": "empresario",
   "fuente": "Cartas a los accionistas de Amazon (1997 y 2016)",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f006",
   "contexto": "inicio",
   "texto": "No nos atrevemos a muchas cosas porque son difíciles; son difíciles porque no nos atrevemos.",
   "autor": "Séneca",
   "rol": "filosofo",
   "fuente": "Cartas a Lucilio, 104",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f007",
   "contexto": "inicio",
   "texto": "Sin compromiso nunca empezarás; sin constancia nunca terminarás.",
   "autor": "Denzel Washington",
   "rol": "artista",
   "fuente": "Discurso en los NAACP Image Awards, 2017",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "firme"
  },
  {
   "id": "f008",
   "contexto": "inicio",
   "texto": "Empiezo todos mis libros un 8 de enero.",
   "autor": "Isabel Allende",
   "rol": "escritor",
   "fuente": "Entrevistas",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f009",
   "contexto": "inicio",
   "texto": "El mejor momento para plantar un árbol fue hace veinte años. El segundo mejor es hoy.",
   "autor": "Dicho popular",
   "rol": "proverbio",
   "fuente": "Autor anónimo; documentado desde 1967 (The Plain Dealer)",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "suave"
  },
  {
   "id": "f010",
   "contexto": "inicio",
   "texto": "Sigue hambriento. Sigue siendo un poco loco.",
   "autor": "Steve Jobs",
   "rol": "empresario",
   "fuente": "Discurso en Stanford, 2005 (lema del Whole Earth Catalog)",
   "tipo": "textual",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f011",
   "contexto": "construyendo",
   "texto": "La grandeza no nace de un impulso, sino de una sucesión de pequeñas cosas reunidas.",
   "autor": "Vincent van Gogh",
   "rol": "artista",
   "fuente": "Cartas a su hermano Theo",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f012",
   "contexto": "construyendo",
   "texto": "Las pequeñas cosas hacen que sucedan las grandes.",
   "autor": "John Wooden",
   "rol": "deportista",
   "fuente": "Máximas del entrenador de UCLA",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f013",
   "contexto": "construyendo",
   "texto": "No te elevas al nivel de tus metas: caes al nivel de tus sistemas.",
   "autor": "James Clear",
   "rol": "autor",
   "fuente": "Hábitos atómicos",
   "tipo": "textual",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f014",
   "contexto": "construyendo",
   "texto": "Sobreestimamos el cambio de los próximos dos años y subestimamos el de los próximos diez.",
   "autor": "Bill Gates",
   "rol": "empresario",
   "fuente": "Camino al futuro (The Road Ahead), 1995",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f015",
   "contexto": "construyendo",
   "texto": "Tuve que trabajar duro; quien trabaje igual de duro llegará igual de lejos.",
   "autor": "Johann Sebastian Bach",
   "rol": "artista",
   "fuente": "Citado por J. N. Forkel, Sobre la vida, el arte y la obra de J. S. Bach, 1802",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f016",
   "contexto": "construyendo",
   "texto": "Olvida la inspiración. El hábito es más fiable: te sostiene estés inspirado o no.",
   "autor": "Octavia E. Butler",
   "rol": "escritor",
   "fuente": "Ensayo «Furor Scribendi» (en Bloodchild and Other Stories)",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f017",
   "contexto": "construyendo",
   "texto": "La inspiración es para aficionados; el resto simplemente aparecemos y nos ponemos a trabajar.",
   "autor": "Chuck Close",
   "rol": "artista",
   "fuente": "Entrevista con Joe Fig, 2006 (Inside the Painter's Studio, 2009)",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "firme"
  },
  {
   "id": "f018",
   "contexto": "construyendo",
   "texto": "Nos hacemos justos practicando la justicia y valientes practicando la valentía.",
   "autor": "Aristóteles",
   "rol": "filosofo",
   "fuente": "Ética a Nicómaco, II.1",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f019",
   "contexto": "construyendo",
   "texto": "Ninguna obra grande se logra de golpe; ni siquiera la uva o el higo maduran de repente.",
   "autor": "Epicteto",
   "rol": "filosofo",
   "fuente": "Discursos, I.15",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "suave"
  },
  {
   "id": "f020",
   "contexto": "construyendo",
   "texto": "La gota horada la piedra.",
   "autor": "Ovidio",
   "rol": "escritor",
   "fuente": "Pónticas, IV.10",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f021",
   "contexto": "construyendo",
   "texto": "Siento que hago progresos cada día.",
   "autor": "Pau Casals",
   "rol": "artista",
   "fuente": "Carta citada en The New York Times, 1946",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "suave"
  },
  {
   "id": "f022",
   "contexto": "construyendo",
   "texto": "El entusiasmo es común. La resistencia es rara.",
   "autor": "Angela Duckworth",
   "rol": "autor",
   "fuente": "Grit, 2016",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f023",
   "contexto": "racha_larga",
   "texto": "Tu alma se tiñe del color de tus pensamientos habituales.",
   "autor": "Marco Aurelio",
   "rol": "filosofo",
   "fuente": "Meditaciones, V.16",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f024",
   "contexto": "racha_larga",
   "texto": "La lucha hacia las cimas basta para llenar un corazón humano. Hay que imaginar a Sísifo feliz.",
   "autor": "Albert Camus",
   "rol": "filosofo",
   "fuente": "El mito de Sísifo, 1942",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f025",
   "contexto": "racha_larga",
   "texto": "A los noventa penetraré más hondo en el misterio; a los cien mi obra tendrá vida propia.",
   "autor": "Hokusai",
   "rol": "artista",
   "fuente": "Posfacio de Cien vistas del monte Fuji, 1834",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f026",
   "contexto": "racha_larga",
   "texto": "Solo los disciplinados son libres en la vida.",
   "autor": "Eliud Kipchoge",
   "rol": "deportista",
   "fuente": "Discurso en la Oxford Union, 2017",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "firme"
  },
  {
   "id": "f027",
   "contexto": "racha_larga",
   "texto": "La disciplina es libertad.",
   "autor": "Jocko Willink",
   "rol": "autor",
   "fuente": "Discipline Equals Freedom, 2017",
   "tipo": "textual",
   "confianza": "Alta",
   "tono": "firme"
  },
  {
   "id": "f028",
   "contexto": "racha_larga",
   "texto": "La vida, si sabes usarla, es larga.",
   "autor": "Séneca",
   "rol": "filosofo",
   "fuente": "Sobre la brevedad de la vida, 2",
   "tipo": "textual",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f029",
   "contexto": "racha_larga",
   "texto": "La disciplina es el puente entre los pensamientos y los logros.",
   "autor": "Jim Rohn",
   "rol": "autor",
   "fuente": "7 Strategies for Wealth & Happiness, 1985",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "firme"
  },
  {
   "id": "f030",
   "contexto": "racha_larga",
   "texto": "Mil días de práctica para forjar; diez mil para pulir.",
   "autor": "Miyamoto Musashi",
   "rol": "deportista",
   "fuente": "El libro de los cinco anillos, Libro del Agua",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f031",
   "contexto": "racha_larga",
   "texto": "Si mejoras un 1% cada día durante un año, terminarás siendo treinta y siete veces mejor.",
   "autor": "James Clear",
   "rol": "autor",
   "fuente": "Hábitos atómicos",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f032",
   "contexto": "racha_larga",
   "texto": "Somos lo que hacemos repetidamente. La excelencia no es un acto, sino un hábito.",
   "autor": "Will Durant",
   "rol": "escritor",
   "fuente": "Historia de la filosofía, 1926 (resumiendo a Aristóteles)",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f033",
   "contexto": "hito",
   "texto": "No es que tengamos poco tiempo, sino que perdemos mucho.",
   "autor": "Séneca",
   "rol": "filosofo",
   "fuente": "Sobre la brevedad de la vida, 1",
   "tipo": "textual",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f034",
   "contexto": "hito",
   "texto": "¿Hemos vencido a un enemigo? A nadie, sino a nosotros mismos.",
   "autor": "George Mallory",
   "rol": "deportista",
   "fuente": "The Alpine Journal, 1918",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f035",
   "contexto": "hito",
   "texto": "Nunca se logró nada grande sin entusiasmo.",
   "autor": "Ralph Waldo Emerson",
   "rol": "escritor",
   "fuente": "Ensayo «Círculos», 1841",
   "tipo": "textual",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f036",
   "contexto": "hito",
   "texto": "El genio es un uno por ciento de inspiración y un noventa y nueve por ciento de transpiración.",
   "autor": "Thomas Edison",
   "rol": "empresario",
   "fuente": "Citada en Harper's Monthly, 1932",
   "tipo": "textual",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f037",
   "contexto": "hito",
   "texto": "La única forma de hacer un gran trabajo es amar lo que haces.",
   "autor": "Steve Jobs",
   "rol": "empresario",
   "fuente": "Discurso en Stanford, 2005",
   "tipo": "textual",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f038",
   "contexto": "hito",
   "texto": "Deja de discutir cómo debe ser un buen hombre. Sé uno.",
   "autor": "Marco Aurelio",
   "rol": "filosofo",
   "fuente": "Meditaciones, X.16",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "firme"
  },
  {
   "id": "f039",
   "contexto": "dia_dificil",
   "texto": "Si oyes una voz dentro de ti que dice «no puedes pintar», entonces pinta, y esa voz se callará.",
   "autor": "Vincent van Gogh",
   "rol": "artista",
   "fuente": "Carta a Theo, 1883",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "suave"
  },
  {
   "id": "f040",
   "contexto": "dia_dificil",
   "texto": "Si algo merece la pena hacerse, merece la pena hacerlo mal.",
   "autor": "G. K. Chesterton",
   "rol": "escritor",
   "fuente": "Lo que está mal en el mundo, 1910",
   "tipo": "textual",
   "confianza": "Alta",
   "tono": "suave"
  },
  {
   "id": "f041",
   "contexto": "dia_dificil",
   "texto": "Casi todo buen texto empieza con un primer borrador terrible.",
   "autor": "Anne Lamott",
   "rol": "escritor",
   "fuente": "Pájaro por pájaro (Bird by Bird), 1994",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "suave"
  },
  {
   "id": "f042",
   "contexto": "dia_dificil",
   "texto": "El dolor es inevitable. El sufrimiento es opcional.",
   "autor": "Haruki Murakami",
   "rol": "escritor",
   "fuente": "De qué hablo cuando hablo de correr, 2007 (mantra que cita de otro corredor)",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f043",
   "contexto": "construyendo",
   "texto": "Cuando te cueste levantarte al amanecer, piensa: me despierto para hacer el trabajo de un ser humano.",
   "autor": "Marco Aurelio",
   "rol": "filosofo",
   "fuente": "Meditaciones, V.1",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "firme"
  },
  {
   "id": "f044",
   "contexto": "dia_dificil",
   "texto": "Haz lo que puedas, con lo que tengas, donde estés.",
   "autor": "Theodore Roosevelt",
   "rol": "lider",
   "fuente": "Autobiografía, 1913 (cita a Squire Bill Widener)",
   "tipo": "textual",
   "confianza": "Alta",
   "tono": "suave"
  },
  {
   "id": "f045",
   "contexto": "dia_dificil",
   "texto": "La presión es un privilegio.",
   "autor": "Billie Jean King",
   "rol": "deportista",
   "fuente": "Pressure Is a Privilege, 2008",
   "tipo": "textual",
   "confianza": "Alta",
   "tono": "neutro"
  },
  {
   "id": "f046",
   "contexto": "racha_larga",
   "texto": "El talento es una mercancía terriblemente barata, más barata que la sal de mesa.",
   "autor": "Stephen King",
   "rol": "escritor",
   "fuente": "Danse Macabre, 1981",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "firme"
  },
  {
   "id": "f047",
   "contexto": "dia_dificil",
   "texto": "Lo mejor es enemigo de lo bueno.",
   "autor": "Voltaire",
   "rol": "escritor",
   "fuente": "La Bégueule, 1772",
   "tipo": "textual",
   "confianza": "Alta",
   "tono": "suave"
  },
  {
   "id": "f048",
   "contexto": "dia_dificil",
   "texto": "No nos perturban las cosas, sino la opinión que tenemos de ellas.",
   "autor": "Epicteto",
   "rol": "filosofo",
   "fuente": "Enquiridión, 5",
   "tipo": "textual",
   "confianza": "Alta",
   "tono": "suave"
  },
  {
   "id": "f049",
   "contexto": "dia_dificil",
   "texto": "Cuando ya no podemos cambiar una situación, el reto es cambiarnos a nosotros mismos.",
   "autor": "Viktor Frankl",
   "rol": "autor",
   "fuente": "El hombre en busca de sentido, 1946",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "suave"
  },
  {
   "id": "f050",
   "contexto": "racha_larga",
   "texto": "Odiaba cada minuto, pero me decía: sufre ahora y vive el resto de tu vida como un campeón.",
   "autor": "Muhammad Ali",
   "rol": "deportista",
   "fuente": "Citado en Newsweek, 1978",
   "tipo": "adaptada",
   "confianza": "Alta",
   "tono": "firme"
  },
  {
   "id": "f051",
   "contexto": "tropiezo",
   "texto": "Fallar una vez es un accidente. Lo importante es no fallar dos.",
   "autor": "James Clear",
